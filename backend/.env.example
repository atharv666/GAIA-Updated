# Copy to backend/.env and fill in. Every value has a sensible default.

# --- Farm --------------------------------------------------------------------------------
FARM_NAME=Green Acres
FARMER_NAME=Arjun
FARM_TIMEZONE=Asia/Kolkata
FARM_REGION=India

# --- Database ----------------------------------------------------------------------------
# embedded  -> local PostgreSQL 16 + pgvector via pgserver (no Docker needed)
# postgresql://gaia:gaia@localhost:5432/gaia  -> external Postgres with pgvector (docker-compose)
DATABASE_URL=embedded

# --- Generative AI -----------------------------------------------------------------------
# Gemini (recommended; free tier at https://aistudio.google.com/apikey). One key powers the
# chat LLM, the vision-language model and the embeddings.
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# VLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# GEMINI_THINKING_BUDGET=0          # optional: lower latency on 2.5 Flash models

# OpenAI-compatible providers (used automatically when no Gemini key is set, or force with
# LLM_PROVIDER=openai_compat / VLM_PROVIDER=openai_compat).
#   Groq:     OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#             LLM_MODEL=llama-3.3-70b-versatile  VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   xAI Grok: OPENAI_COMPAT_BASE_URL=https://api.x.ai/v1   LLM_MODEL=<grok model>  VLM_MODEL=<grok vision model>
#   Local, no keys (Ollama): OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1  OPENAI_COMPAT_API_KEY=ollama
#             LLM_PROVIDER=openai_compat VLM_PROVIDER=openai_compat LLM_MODEL=gemma4:e4b VLM_MODEL=gemma4:e4b
#             OPENAI_COMPAT_REASONING_EFFORT=none  LLM_TIMEOUT_SECONDS=300   (tested end to end)
# Groq has no embedding API: keep GEMINI_API_KEY for embeddings, or the offline hashing embedder is used.
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_REASONING_EFFORT=none   # thinking models: none | low | default | high (provider-specific)
# LLM_PROVIDER=auto
# VLM_PROVIDER=auto
# EMBEDDING_PROVIDER=auto

# --- Web search (open-ended chat + diagnosis agent) --------------------------------------
# auto = Tavily if TAVILY_API_KEY is set, otherwise DuckDuckGo (no key needed)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# --- Sensor ingestion ---------------------------------------------------------------------
WINDOW_MINUTES=15
INGEST_INTERVAL_SECONDS=60
# Optional LLM-written daily interpretation chunk (numbers always come from deterministic stats)
LLM_DIGEST_ENABLED=false

# --- Security -------------------------------------------------------------------------------
# Rover telemetry must send X-Device-Key; set the same value in firmware/esp32cam_rover/config.h
DEVICE_KEY=gaia-rover-dev-key
# Optional: require X-API-Key from the app and the website
API_KEY=

# --- Rover (used by the website's rover page and "capture from rover") -----------------------
ROVER_BASE_URL=http://192.168.4.1
# ROVER_STREAM_URL=http://192.168.4.1:81/stream
